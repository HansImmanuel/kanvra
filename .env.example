# Copy to .env and adjust for your environment. Values shown are local-dev defaults.

# PostgreSQL (docker-compose)
POSTGRES_DB=kanvra
POSTGRES_USER=kanvra
POSTGRES_PASSWORD=kanvra_dev

# Backend datasource (must match the Postgres values above)
KANVRA_DB_URL=jdbc:postgresql://localhost:5432/kanvra
KANVRA_DB_USERNAME=kanvra
KANVRA_DB_PASSWORD=kanvra_dev

# Kafka (EXTERNAL advertised listener: 29092 from the host, 9092 in-network)
KANVRA_KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Auth / JWT
# Use a long random base64 secret in real environments (e.g. `openssl rand -base64 64`)
KANVRA_JWT_SECRET=change-me-to-a-long-random-base64-secret-at-least-32-bytes

# Allowed frontend origins (comma-separated)
KANVRA_CORS_ORIGINS=http://localhost:3000

# (Frontend) Base URL of the backend to proxy /api/* to (Next rewrite).
# NOTE: like NEXT_PUBLIC_WS_URL, this is baked in at BUILD time when running
# the frontend as a container (passed as a build arg by docker-compose.yml,
# default http://backend:8080 in-network). It is a true runtime value only
# for `npm run dev` / `next start` on the host.
KANVRA_BACKEND_URL=http://localhost:8080

# (Frontend) WebSocket endpoint of the backend /ws (dev default; override behind a proxy).
# NOTE: this is inlined into the client bundle at BUILD time. When building the
# frontend Docker image it is passed as a build arg (docker-compose.yml does this);
# changing it at runtime requires a rebuild. Behind the optional nginx gateway
# profile (`docker compose --profile gateway up`) it is irrelevant — /ws is
# proxied same-origin.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Comma-separated allowlist of trusted reverse-proxy IPs. X-Forwarded-For is only
# honored for requests from these addresses (empty = never trust the header).
KANVRA_TRUSTED_PROXIES=

# Flag auth cookies Secure outside of TLS termination by server.ssl.enabled.
# Set to true when serving over HTTPS behind a reverse proxy.
KANVRA_COOKIES_SECURE=false
