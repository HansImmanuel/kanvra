# Copy to .env and adjust for your environment. Values shown are local-dev defaults.

# PostgreSQL (docker-compose)
POSTGRES_DB=kanvra
POSTGRES_USER=kanvra
POSTGRES_PASSWORD=kanvra_dev

# Backend datasource (must match the Postgres values above)
KANVRA_DB_URL=jdbc:postgresql://localhost:5432/kanvra
KANVRA_DB_USERNAME=kanvra
KANVRA_DB_PASSWORD=kanvra_dev

# Kafka
KANVRA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Auth / JWT
# Use a long random base64 secret in real environments (e.g. `openssl rand -base64 64`)
KANVRA_JWT_SECRET=change-me-to-a-long-random-base64-secret-at-least-32-bytes

# Allowed frontend origins (comma-separated)
KANVRA_CORS_ORIGINS=http://localhost:3000
